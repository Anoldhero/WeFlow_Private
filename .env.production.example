# 仅保存在云端服务器。不随安装包分发，不提交版本库。
# 例如 ai.your-domain.com，填写前先完成 DNS 解析，并开放 80/443。
CLOUD_DOMAIN=
NODE_ENV=production
AI_PROVIDER=compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROTOCOL=chat-completions
LLM_TOKEN_FIELD=max_completion_tokens
LLM_MAX_OUTPUT_TOKENS=1800
REPORT_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_MS=90000
DAILY_REQUEST_LIMIT=30
SESSION_TTL_DAYS=7
