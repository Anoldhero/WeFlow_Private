# 仅用于运营方的服务端；此文件不会进入客户端安装包。
NODE_ENV=development
HOST=127.0.0.1
PORT=4310
# 仅填写实际反向代理的 IP/CIDR，以逗号分隔。默认不信任 X-Forwarded-For。
TRUSTED_PROXY_CIDRS=
DATABASE_PATH=./data/cloud.sqlite
AI_PROVIDER=compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# OpenAI 地址默认使用 Responses，其他兼容服务默认使用 Chat Completions。
LLM_PROTOCOL=
# 部分兼容服务需要 max_tokens；默认使用 max_completion_tokens。
LLM_TOKEN_FIELD=max_completion_tokens
LLM_MAX_OUTPUT_TOKENS=1800
# 多栏目日报、周报使用单独的输出上限。
REPORT_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_MS=90000
DAILY_REQUEST_LIMIT=30
SESSION_TTL_DAYS=7
# 客户端公开服务地址单独配置在 .env.client，参见 .env.client.example。
